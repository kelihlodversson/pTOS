menu "AES"

config CONF_WITH_AES
	bool "Include the AES and the EmuDesk desktop"
	default n if TARGET_CART
	default y
	help
	  Without the AES there is no graphical desktop; EmuTOS boots
	  straight into EmuCON or runs the program found on the boot device.
	  This is only useful when the image size is severely restricted,
	  such as for the diagnostic cartridge.

if CONF_WITH_AES

config AES_STACK_SIZE
	int "Size of the private AES stack, in LONGs"
	default 2048 if MACHINE_FIREBEE || MACHINE_M548X
	default 590
	help
	  Size of the private stack of each AES process.  It is used for the
	  AES itself, including every call it makes to the VDI, the BIOS and
	  GEMDOS.

	  An application that calls v_gtext() via a USERDEF and links to
	  Gemlib needs a large AES stack, because Gemlib's v_gtext() puts a
	  1024-word buffer on the stack.  This is principally a problem when
	  recompiling for ColdFire systems, hence the larger default there.

	  A suitable value can be estimated by enabling CONF_DEBUG_AES_STACK.

config CONF_WITH_PCGEM
	bool "PC-GEM compatible AES functions"
	default n if TARGET_192
	default y

config CONF_WITH_LOADABLE_CURSORS
	bool "Loadable mouse cursors"
	default y
	help
	  Allow the mouse cursors to be loaded from A:\EMUCURS.RSC instead
	  of using the built-in ones.

config CONF_WITH_COLOUR_ICONS
	bool "Colour icons"
	default n if TARGET_192 || TARGET_CART
	default y
	help
	  Recognise 'new format' RSC files and render the CICONBLK colour
	  icon data they may contain, as in Atari TOS 4.  Resources without
	  colour icon data, and legacy mono ICONBLK icons, are unaffected.

	  Space is tight on the smallest ROM targets, so this is disabled
	  by default there.

config CONF_WITH_LEGACY_RSC_LOAD
	bool "Use legacy resource loader"
	depends on ARCH_M68K
	default y if TARGET_192
	default n
	help
	  Use the former in-place resource loader instead of the portable
	  canonical resource loader.  It relies on the m68k native structure
	  layout matching Atari's big-endian resource-file layout.

	  The 192 KB ROM enables this by default because its ROM budget cannot
	  accommodate the portable loader.  Other m68k images should normally
	  use the portable loader, but may select this option when space is
	  more important than the portable loader's canonical decoding and
	  validation.

config CONF_WITH_NICELINES
	bool "Menu nicelines"
	default y
	help
	  Draw menu separator lines with the VDI instead of rendering the
	  traditional disabled dash string.

endif

endmenu
