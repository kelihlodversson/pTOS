#!/usr/bin/env python3
#
# as - assembler wrapper for LTO links on the mintelf m68k toolchain
#
# With -flto the final code is generated by lto-wrapper at link time, so the
# C -> assembler -> fix-m68k-local-labels.py -> object pipeline in the
# Makefile is bypassed.  The Makefile puts this directory on gcc's -B path
# for LTO links, and this wrapper runs the same label fix on every assembly
# file gcc hands to the assembler, then calls the real one, named by the
# LTO_REAL_AS environment variable.
#
"""Run fix-m68k-local-labels.py on the input, then the real assembler."""

import os
import re
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
FIX = os.path.join(HERE, "..", "fix-m68k-local-labels.py")


# Register names gas would read as operands.  A symbol that starts with one
# of them (acc, mask.0.lto_priv.0, ...) must be renamed in every LTO
# partition that mentions it, including those that only see it in ".hidden".
RESERVED = set("acc accext01 accext23 macsr mask sr ccr pc zpc sp fp usp "
               "vbr sfc dfc cacr caar msp isp tc itt0 itt1 dtt0 dtt1 mmusr "
               "urp srp pcr rombar rambar".split())
DECLARED = re.compile(r"^\s*\.(?:hidden|globl|local|type)\s+"
                      r"([A-Za-z_.][A-Za-z0-9_.]*)", re.M)


def rename_reserved(path):
    with open(path, "r", encoding="utf-8") as source:
        text = source.read()
    names = set(n for n in DECLARED.findall(text)
                if n.split(".")[0] in RESERVED)
    for name in sorted(names, key=len, reverse=True):
        symbol = re.compile(r"(?<![A-Za-z0-9_.])" + re.escape(name)
                            + r"(?![A-Za-z0-9_]|\.(?![bwl](?:\b)))")
        text = symbol.sub("_" + name, text)
    with open(path, "w", encoding="utf-8") as out:
        out.write(text)


def main():
    args = sys.argv[1:]
    real = os.environ.get("LTO_REAL_AS", "m68k-atari-mintelf-as")
    fixed = None
    for i, arg in enumerate(args):
        if arg.endswith(".s") and os.path.isfile(arg) \
                and (i == 0 or args[i - 1] != "-o"):
            fd, fixed = tempfile.mkstemp(suffix=".s")
            os.close(fd)
            subprocess.check_call([sys.executable, FIX, arg, fixed])
            rename_reserved(fixed)
            args[i] = fixed
            break
    try:
        status = subprocess.call([real] + args)
    finally:
        if fixed:
            os.unlink(fixed)
    sys.exit(status)


main()
