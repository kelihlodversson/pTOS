# Merged after a defconfig by host fixtures that compile kernel sources
# against the configuration they were written for: the native process
# profile off, as every preset resolved before it
# became the default. A fixture that needs one of these sets it again
# afterwards. Native and CI regression runs cover the default-on profile.
CONF_WITH_PFORK=n
CONF_WITH_PROCESS_FILES=n
CONF_WITH_PRIVATE_CLONE=n
CONF_WITH_PTHJOIN=n
CONF_WITH_PTERMGRP=n
CONF_WITH_PCLONE=n
CONF_WITH_NATIVE_SCHED=n
