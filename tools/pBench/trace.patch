+/*
+ * Temporary tracing, see tools/pBench/trace.patch: consecutive identical
+ * lines are folded into "xN" so that a benchmark's output stays readable.
+ */
+static char trace_last[160];
+static LONG trace_rep, trace_t0;
+void trace_flush(void)
+{
+    if (trace_last[0])
+        kprintf("%ld x%ld %s\n", trace_t0, trace_rep, trace_last);
+    trace_last[0] = 0;
+}
+void trace_line(const char *line)
+{
+    if (trace_last[0] && !strcmp(line, trace_last)) { trace_rep++; return; }
+    trace_flush();
+    strcpy(trace_last, line);
+    trace_rep = 1;
+    trace_t0 = hz_200;
+}
+static char vtrace_b[160];
+static void vtrace(void)
