+    for (i = 0; i < CONTRL->nintin && i < 6; i++) n += sprintf(b+n, " %d", INTIN[i]);
+    n += sprintf(b+n, " p:");
+    for (i = 0; i < CONTRL->nptsin*2 && i < 8; i++) n += sprintf(b+n, " %d", PTSIN[i]);
+    trace_line(b);
+}
