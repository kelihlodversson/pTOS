#
# Kconfig - top level configuration menu for pTOS
#
# Copyright (C) 2001-2017 The EmuTOS development team.
#
# This file is distributed under the GPL, version 2 or at your
# option any later version.  See doc/license.txt for details.
#
# The configuration system works like the one used by the Linux kernel:
#
#   make <name>_defconfig   load one of the ready-made configurations
#   make menuconfig         edit the configuration interactively
#   make                    build the configured image
#
# The result of the configuration is stored in the file '.config'.  From
# there the build system generates obj/autoconf.h (included by every source
# file through include/config.h) and obj/auto.conf (included by the
# Makefile).  Neither generated file should ever be edited by hand.
#

mainmenu "pTOS/EmuTOS Configuration"

source "Kconfig.machine"
source "Kconfig.image"
source "Kconfig.i18n"

menu "Kernel features"

source "bios/Kconfig"
source "bdos/Kconfig"
source "fs/Kconfig"
source "vdi/Kconfig"
source "aes/Kconfig"
source "desk/Kconfig"
source "cli/Kconfig"
source "usb/Kconfig"

endmenu

source "Kconfig.debug"
