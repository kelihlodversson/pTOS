menu "Clock and NVRAM"

config CONF_WITH_IKBD_CLOCK
	bool "IKBD clock support"
	depends on CONF_ATARI_HARDWARE
	default n if MACHINE_ARANYM
	default y

config CONF_WITH_MEGARTC
	bool "Mega ST real-time clock support"
	depends on CONF_ATARI_HARDWARE
	default n if MACHINE_ARANYM || MACHINE_FIREBEE
	default y

config CONF_WITH_ICDRTC
	bool "ICD AdSCSI Plus ST real-time clock support"
	depends on CONF_WITH_ACSI
	default n if TARGET_192 || TARGET_CART || MACHINE_FIREBEE
	default y
	help
	  Support for the real-time clock on the ICD AdSCSI Plus ST board,
	  which is attached via the ACSI interface.  It is useless on the
	  FireBee, which has an NVRAM clock.

config CONF_WITH_NVRAM
	bool "NVRAM support"
	depends on CONF_ATARI_HARDWARE
	default n if TARGET_192 || TARGET_CART
	default y

config CONF_WITH_ULTRASATAN_CLOCK
	bool "UltraSatan real-time clock support"
	depends on CONF_WITH_ACSI
	default y
	help
	  Support for the real-time clock on the UltraSatan ACSI hard disk
	  interface.  Useless on the FireBee, which has its own NVRAM clock.

config CONF_WITH_BOOTARGS_LANG
	bool "Boot command line language/keyboard override"
	depends on MACHINE_RPI || MACHINE_VIRT_ARM
	default y
	help
	  These machines have no NVRAM (see CONF_WITH_NVRAM) to store the
	  country/keyboard setting a multi-language image picks at run
	  time.  Say y to read it instead from a "ptos.lang=xx" parameter
	  on the ARM boot loader's command line, where xx is one of the
	  two-letter country codes listed in country.mk (e.g. "de", "fr",
	  "uk").  On the Raspberry Pi, set this in cmdline.txt.  Under QEMU,
	  use -append "ptos.lang=xx" when the chosen loader actually passes bootargs
	  (see doc/country.txt).  Only takes effect on a
	  multi-language image (say n to BUILD_UNIQUE_COUNTRY); with no
	  matching parameter, or on a single-country image, the country
	  baked in at build time is used as before.

endmenu

menu "Miscellaneous BIOS features"

config CONF_COLDFIRE_TIMER_C
	bool "Simulate Timer C with an internal ColdFire timer"
	depends on ARCH_COLDFIRE && !CONF_WITH_MFP
	default y
	help
	  The 200 Hz system timer is normally provided by the MFP.  On a
	  ColdFire board without MFP it has to be simulated using one of the
	  general purpose timers of the processor.

config CONF_RASPI_TIMER_C
	bool "Simulate Timer C with an ARM timer"
	depends on MACHINE_RPI
	default y
	help
	  The 200 Hz system timer is provided by one of the ARM side timers
	  of the BCM283x SoC.

config CONF_WITH_CARTRIDGE
	bool "ROM port cartridge support"
	depends on CONF_ATARI_HARDWARE && !DIAGNOSTIC_CARTRIDGE
	default n if MACHINE_ARANYM
	default y
	help
	  Run the application cartridge plugged in the ROM port, if any.
	  Diagnostic and application cartridges have different magic
	  numbers, so a diagnostic cartridge can not also be an application
	  cartridge.

config CONF_WITH_SFP004
	bool "Mega ST SFP004 FPU support"
	depends on CONF_ATARI_HARDWARE
	default n if MACHINE_ARANYM || MACHINE_FIREBEE
	default y

config CONF_WITH_DSP
	bool "Falcon DSP support"
	depends on CONF_WITH_VIDEL
	default n if MACHINE_FIREBEE
	default y
	help
	  Support for the Falcon's Motorola 56001 DSP, detected and used by
	  Xbios DSP calls.

config CONF_WITH_BIOS_EXTENSIONS
	bool "BIOS extension functions"
	default n if TARGET_192 || TARGET_CART
	default y

config CONF_WITH_SHUTDOWN
	bool "Shutdown support"
	default n if TARGET_192 || TARGET_CART
	default y if DETECT_NATIVE_FEATURES || MACHINE_FIREBEE || MACHINE_AMIGA
	default n
	help
	  Enable the shutdown() function, which tries to power off the
	  machine when that is possible.

config USE_STATIC_INLINES
	bool "Use static inline functions"
	depends on !ARCH_ARM
	default y
	help
	  Compile some very small functions as static inlines.  This makes
	  the code both smaller and faster on any reasonably modern
	  compiler.

endmenu
