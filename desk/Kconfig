menu "EmuDesk desktop"
	depends on CONF_WITH_AES

config CONF_WITH_WINDOW_ICONS
	bool "Icons for files and folders"
	default n if TARGET_192
	default y

config CONF_WITH_ALT_DESKTOP_GRAPHICS
	bool "Alternate desktop graphic elements"
	depends on CONF_WITH_EXTENDED_OBJECTS
	default n if TARGET_192 || TARGET_256 || TARGET_512
	default y
	help
	  Replace Atari-style desktop graphic elements with alternate
	  versions, e.g. left-aligned and underlined dialog titles instead
	  of the centered, unadorned Atari TOS style.

config CONF_WITH_DESKTOP_SHORTCUTS
	bool "Desktop shortcuts"
	default n if TARGET_192
	default y
	help
	  Allow files and folders to be installed on the desktop as
	  shortcuts.

config CONF_WITH_BACKGROUNDS
	bool "Configurable backgrounds"
	default n if TARGET_192
	default y
	help
	  Allow the background pattern and colour of the desktop and of the
	  windows to be configured.

config CONF_WITH_FILEMASK
	bool "Configurable file mask"
	default n if TARGET_192
	default y

config CONF_WITH_DESKTOP_CONFIG
	bool "Desktop configuration dialog"
	default n if TARGET_192
	default y

config CONF_WITH_READ_INF
	bool "Read .INF file"
	default n if TARGET_192
	default y
	help
	  Allow the user to merge an EMUDESK.INF file into the running
	  desktop's configuration via a "Read .INF file" menu item, without
	  restarting the desktop.

config CONF_WITH_VIEWER_SUPPORT
	bool "Default document viewer"
	default n if TARGET_192 || TARGET_256 || TARGET_512
	default y
	help
	  Allow an application to be marked as the default viewer (as on
	  Atari TOS 4), used to display document files that have no
	  installed application of their own.

config CONF_WITH_FORMAT
	bool "Floppy formatting"
	depends on CONF_ATARI_HARDWARE
	default n if TARGET_192 || MACHINE_ARANYM || MACHINE_FIREBEE
	default y

config CONF_WITH_SHOW_FILE
	bool "Show a file by double-clicking on it"
	default n if TARGET_192
	default y

config CONF_WITH_SEARCH
	bool "'Search' desktop menu item"
	default n if TARGET_192
	default y
	help
	  Prompt for a search string, then search for matching files and
	  folders, as on Atari TOS 2/3/4.

config CONF_WITH_SELECTALL
	bool "'Select all items' desktop menu item"
	default n if TARGET_192
	default y
	help
	  Select all items in the currently-topped window, as on Atari TOS
	  2/3/4.  Only items with an on-screen icon are marked; unlike Atari
	  TOS, items scrolled out of view are not.

config CONF_WITH_BOTTOMTOTOP
	bool "'Cycle windows' desktop menu item"
	default n if TARGET_192
	default y
	help
	  Top the bottom window, as on Atari TOS 2/3/4.

config CONF_WITH_SIZE_TO_FIT
	bool "'Size to fit' desktop menu item"
	default n if TARGET_192 || TARGET_256
	default y
	help
	  Control whether a window's width determines the number of columns
	  of files displayed (the only behaviour without this option), or
	  whether a window is a scrollable view onto the full width of the
	  desktop, as on Atari TOS 2/3/4.

config CONF_WITH_PRINTER_ICON
	bool "Printer icon"
	default n if TARGET_192
	default y
	help
	  Support a printer icon on the desktop: info/rename it like the
	  trash can, and install it (or remove it) via the "Install
	  application" dialog's printer button, as on Atari TOS 2/3/4.
	  Dragging a document onto it is not yet implemented.

config CONF_WITH_EASTER_EGG
	bool "EmuDesk easter egg"
	default n if TARGET_192
	default y

config CONF_WITH_VDI_CICON_TEST
	bool "Embedded colour-icon rendering test"
	depends on CONF_WITH_AES && CONF_WITH_COLOUR_ICONS && !CONF_WITH_LEGACY_RSC_LOAD
	default n
	help
	  Test hook for issue #107: embeds a hand-built 'new format' RSC
	  with a single G_CICON and draws it over the desktop background at
	  boot, exercising gr_gicon() -> gr_colourblit() on both the packed
	  truecolor (RPi) and the planar (Atari) paths.  For verification
	  only -- do not enable in production images.

endmenu
