# ELF kernel image for QEMU's m68k 'virt' machine (qemu-system-m68k -M virt)
MACHINE_VIRT_M68K=y

# QEMU's m68k 'virt' board defaults to an m68040 core (see hw/m68k/virt.c's
# mc->default_cpu_type).  This targets m68020 code generation, which runs on
# -cpu m68020 (the invocation documented in readme.md) and -cpu m68040.  The
# boot-time CPU detection in bios/arch/m68k/processor.S avoids the
# 68060-only PCR control register on this board, because QEMU's m68k target
# cpu_abort()s the whole VM on that read instead of raising the guest
# illegal-instruction exception (target/m68k/helper.c: HELPER(m68k_movec_from),
# case M68K_CR_PCR), and QEMU's 68060 lacks the PCR, the MMU registers and
# cpusha/cinva as well.  For -cpu m68060 also set CPUFLAGS="-m68060"
# (menuconfig): QEMU has no software package for the 64-bit mulu.l/divu.l
# that -m68020 code generation may use, which the 68060 does not implement.
# (There is no per-target CPUFLAGS default for this board yet, unlike the
# Raspberry Pi targets, so it is spelled out here, following the
# MACHINE_ARANYM precedent in Kconfig.machine.)
CPUFLAGS="-m68020"

# QEMU's 'virt' board has no IDE interface; without this, bios/ide.c fails
# to build because struct IDE is never defined for this machine. Matched
# to the same override already used by MACHINE_RPI and MACHINE_VIRT_ARM.
CONF_WITH_IDE=n

# This target must be built with an ELF-capable toolchain: emutos.ld forces
# OUTPUT_FORMAT(elf32-m68k) for MACHINE_VIRT_M68K (QEMU's -kernel loader
# needs a real ELF image, not a flat binary), and the a.out toolchain's
# linker has no elf32-m68k target compiled in at all ("target elf32-m68k
# not found").  Kconfig forbids the cross-mint toolchain for this machine
# (BUILD_TOOLCHAIN_MINT depends on !MACHINE_VIRT_M68K), so the default
# mintelf is guaranteed; nothing needs pinning in this defconfig.

# Enables the pluggable filesystem layer (fs/Kconfig) and, on by default
# once this is set, the virtio-9p GEMDOS driver (bios/Kconfig's
# CONF_WITH_VIRTIO_9P) - lets CI build and boot-test a QEMU
# virtio-9p-device host directory as drive Q: (see #157). No effect
# without a matching -fsdev/-device on the QEMU command line.
CONF_WITH_PLUGGABLE_FS=y
