# 512 KB Atari ROM image with the kernel-private process records (#420) and
# the validation of GEMDOS pointers (#439) on: CI builds the generic KPROC and
# user-copy code on m68k, where the options are not mandatory.
TARGET_512=y
CONF_WITH_KPROC=y
CONF_WITH_USER_COPY=y
# Single-country, matching upstream's own 512/256/192 targets.
BUILD_UNIQUE_COUNTRY=y
