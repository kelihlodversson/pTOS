# Amiga 1000 Kickstart disk
MACHINE_AMIGA=y
TARGET_AMIGA_KICKDISK=y

# Without -mfastcall the 256 KB ROM no longer fits (the kernel is no longer built
# with -mshort), so this image needs the smaller code the register calling
# convention gives.
CONF_WITH_MFASTCALL=y

# LRA register allocator test (#996): this configuration's default CPU
# flags plus -mlra.
CPUFLAGS="-m68000 -mlra"
