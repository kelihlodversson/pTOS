# 512 KB Atari ROM image, for the TT and the Falcon
TARGET_512=y
# Single-country, matching upstream's own 512/256/192 targets (UNIQUE=
# $(COUNTRY) in their Makefile) -- the multi-language image no longer
# fits in 512K alongside upstream's current feature set.
BUILD_UNIQUE_COUNTRY=y

# LRA register allocator test (#996): this configuration's default CPU
# flags plus -mlra.
CPUFLAGS="-m68000 -mlra"
