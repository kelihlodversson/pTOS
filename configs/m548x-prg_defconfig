# RAM TOS program for an M548x board running BaS_gcc
MACHINE_M548X=y
CONF_WITH_BAS_MEMORY_MAP=y
TARGET_PRG=y
OPTIMIZE_SPEED=y
# The multi-language image supports every country at run time.
# BUILD_UNIQUE_COUNTRY is not set

# LRA register allocator test (#996): this configuration's default CPU
# flags plus -mlra.
CPUFLAGS="-mcpu=5475 -mlra"
