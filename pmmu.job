  pmmu-check:
    name: PMMU startup check (virt-m68k-mmu)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # the image loads EmuCON (CONF_EXTERNAL_CLI): libcmini builds it
          submodules: true

      - uses: ./.github/actions/setup-toolchain
        with:
          arch: m68k

      - name: Install QEMU
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y qemu-system-misc

      - name: Build virt-m68k-mmu
        run: |
          make virt-m68k-mmu_defconfig
          make

      - name: Boot it with and without a PMMU
        run: tools/test-pmmu-check.sh virt-m68k.elf

      - name: Report the failure
        if: failure()
        run: |
          echo "::error title=PMMU startup check::the virt-m68k-mmu image did not refuse a CPU without a PMMU, or did not boot on the 68040"

